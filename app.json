{
  "expo": {
    "name": "GeoGenie",
    "slug": "geogenie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/geogenie_logo.png",
    "scheme": "geogenie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.vijethegde.GeoGenie",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/geogenie_logo.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdge": true,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/geogenie_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0294c63-5ec6-4425-aee1-a48164f5682a"
      }
    },
    "owner": "vijethegde"
  }
}
